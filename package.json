{
  "name": "dsh-shichuang",
  "version": "0.2.0",
  "description": "拾窗：Harness 桌面截图问答入口（Windows MVP）",
  "type": "module",
  "main": "src/host.mjs",
  "exports": { ".": "./src/host.mjs", "./client": "./lib/client.js" },
  "files": ["src/", "lib/", "native/", "skills/", "docs/", "cordis.patch.yml", "README.md"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run build && npm test"
  },
  "engines": { "node": ">=22" },
  "os": ["win32"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-api-session-controller"],
      "platform": "web"
    }
  }
}
